<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>retificas-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>retificas-backend</artifactId>
    <packaging>jar</packaging>

    <!--
        API REST (consumida pela página web/PWA mobile) que reaproveita as
        mesmas entidades e repositórios JPA do core — sem Spring Data, para
        não duplicar a configuração de persistência já existente.

        spring-boot.version e o import do BOM spring-boot-dependencies ficam
        no pom.xml raiz (retificas-parent), pra que o core também herde
        versões gerenciadas consistentes com o Spring Boot.
    -->
    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>retificas-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>retificas-backend</finalName>
        <plugins>
            <!--
                Testes de integração rodam contra um Postgres DESCARTÁVEL local
                (docker-compose.test.yml, porta 5544, banco retificas_test) — nunca
                o banco de produção. As variáveis abaixo substituem as do ambiente
                do processo de teste; GuardaBancoLocal ainda aborta se algo apontar
                para fora da máquina. HOME próprio para o bootstrap não escrever
                credenciais no home real.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>-Duser.home=${project.build.directory}/test-home</argLine>
                    <environmentVariables>
                        <DATABASE_URL>jdbc:postgresql://localhost:5544/retificas_test</DATABASE_URL>
                        <DATABASE_USER>retificas</DATABASE_USER>
                        <DATABASE_PASSWORD>retificas_teste</DATABASE_PASSWORD>
                        <JWT_SECRET>dGVzdGUtc2ludGV0aWNvLXNlbS12YWxvci1yZWFsLTMyYnl0ZXM=</JWT_SECRET>
                        <SSL_ENABLED>false</SSL_ENABLED>
                        <WHATSAPP_TOKEN></WHATSAPP_TOKEN>
                        <WHATSAPP_PHONE_NUMBER_ID></WHATSAPP_PHONE_NUMBER_ID>
                        <ALTO_MEDIDAS_PAGAMENTO_URL></ALTO_MEDIDAS_PAGAMENTO_URL>
                        <ALTO_MEDIDAS_SAIDA_KEY></ALTO_MEDIDAS_SAIDA_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>org.example.backend.BackendApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
