<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="retificasPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.model.PedidoModel</class>
        <class>org.example.model.ClienteModel</class>
        <class>org.example.model.ServicoModel</class>
        <class>org.example.model.PecaModel</class>
        <class>org.example.model.VendedorModel</class>
        <class>org.example.model.CabecoteModel</class>
        <class>org.example.model.ServicoCatalogoModel</class>
        <class>org.example.model.PecaCatalogoModel</class>
        <class>org.example.model.EmpresaModel</class>
        <class>org.example.model.UsuarioModel</class>

        <properties>
            <!-- Valores default aqui batem com o Postgres local do docker-compose.yml
                 (docker compose up -d). Em produção, JPAUtil sobrescreve url/user/password
                 em runtime a partir de DATABASE_URL/DATABASE_USER/DATABASE_PASSWORD. -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/retificas"/>
            <property name="jakarta.persistence.jdbc.user" value="retificas"/>
            <property name="jakarta.persistence.jdbc.password" value="retificas"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <!-- Cria/atualiza o schema automaticamente a partir das entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
